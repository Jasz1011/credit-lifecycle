<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_CreditLifecycle" targetNamespace="https://creditflow.local/bpmn">
  <bpmn:collaboration id="Collaboration_CreditFlow">
    <bpmn:participant id="Participant_CreditFlow" name="CreditFlow" processRef="Process_CreditLifecycle"/>
  </bpmn:collaboration>
  <bpmn:process id="Process_CreditLifecycle" name="Ciclo de vida del crédito" isExecutable="false">
    <bpmn:documentation>Modelo documental del flujo ya implementado. No representa un motor BPM ejecutable. La consulta del plan por identificación es posterior y opcional.</bpmn:documentation>
    <bpmn:laneSet id="LaneSet_Responsibilities">
      <bpmn:lane id="Lane_Analyst" name="Usuario / Analista">
        <bpmn:flowNodeRef>Start_AuthenticatedFlow</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Login</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Register</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Committee" name="Comité de Riesgo">
        <bpmn:flowNodeRef>Task_Review</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_Approved</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Reject</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Approve</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_System" name="Sistema">
        <bpmn:flowNodeRef>Task_SavePending</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_SetRejected</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_Rejected</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>SubProcess_Approval</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>SubProcess_Disbursement</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_Disbursed</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Operator" name="Operador de Desembolso">
        <bpmn:flowNodeRef>Task_SelectApproved</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_EnterBankAccount</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ConfirmDisbursement</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="Start_AuthenticatedFlow" name="Inicio">
      <bpmn:outgoing>Flow_01</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="Task_Login" name="Iniciar sesión">
      <bpmn:incoming>Flow_01</bpmn:incoming>
      <bpmn:outgoing>Flow_02</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="Task_Register" name="Registrar solicitud">
      <bpmn:incoming>Flow_02</bpmn:incoming>
      <bpmn:outgoing>Flow_03</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="Task_SavePending" name="Guardar solicitud (PENDING)">
      <bpmn:incoming>Flow_03</bpmn:incoming>
      <bpmn:outgoing>Flow_04</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:userTask id="Task_Review" name="Revisar solicitud">
      <bpmn:incoming>Flow_04</bpmn:incoming>
      <bpmn:outgoing>Flow_05</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="Gateway_Approved" name="¿Aprobada?">
      <bpmn:incoming>Flow_05</bpmn:incoming>
      <bpmn:outgoing>Flow_06</bpmn:outgoing>
      <bpmn:outgoing>Flow_09</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="Task_Reject" name="Rechazar solicitud">
      <bpmn:incoming>Flow_06</bpmn:incoming>
      <bpmn:outgoing>Flow_07</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="Task_Approve" name="Aprobar con observaciones">
      <bpmn:incoming>Flow_09</bpmn:incoming>
      <bpmn:outgoing>Flow_10</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="Task_SetRejected" name="Marcar REJECTED">
      <bpmn:incoming>Flow_07</bpmn:incoming>
      <bpmn:outgoing>Flow_08</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="End_Rejected" name="Solicitud rechazada">
      <bpmn:incoming>Flow_08</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:subProcess id="SubProcess_Approval" name="Aprobar y generar crédito y plan">
      <bpmn:documentation>Una transacción de base de datos: APPROVED, Credit, número de crédito y exactamente N cuotas; cualquier fallo revierte la operación.</bpmn:documentation>
      <bpmn:incoming>Flow_10</bpmn:incoming>
      <bpmn:outgoing>Flow_11</bpmn:outgoing>
      <bpmn:startEvent id="Approval_Start" name="Inicio">
        <bpmn:outgoing>Approval_Flow_1</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:serviceTask id="Approval_SetApproved" name="Marcar APPROVED">
        <bpmn:incoming>Approval_Flow_1</bpmn:incoming>
        <bpmn:outgoing>Approval_Flow_2</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:serviceTask id="Approval_CreateCredit" name="Crear crédito y número">
        <bpmn:incoming>Approval_Flow_2</bpmn:incoming>
        <bpmn:outgoing>Approval_Flow_3</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:serviceTask id="Approval_GeneratePlan" name="Generar N cuotas">
        <bpmn:incoming>Approval_Flow_3</bpmn:incoming>
        <bpmn:outgoing>Approval_Flow_4</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:endEvent id="Approval_End" name="Fin">
        <bpmn:incoming>Approval_Flow_4</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:sequenceFlow id="Approval_Flow_1" sourceRef="Approval_Start" targetRef="Approval_SetApproved"/>
      <bpmn:sequenceFlow id="Approval_Flow_2" sourceRef="Approval_SetApproved" targetRef="Approval_CreateCredit"/>
      <bpmn:sequenceFlow id="Approval_Flow_3" sourceRef="Approval_CreateCredit" targetRef="Approval_GeneratePlan"/>
      <bpmn:sequenceFlow id="Approval_Flow_4" sourceRef="Approval_GeneratePlan" targetRef="Approval_End"/>
    </bpmn:subProcess>
    <bpmn:userTask id="Task_SelectApproved" name="Seleccionar crédito aprobado">
      <bpmn:incoming>Flow_11</bpmn:incoming>
      <bpmn:outgoing>Flow_12</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="Task_EnterBankAccount" name="Indicar banco y cuenta">
      <bpmn:incoming>Flow_12</bpmn:incoming>
      <bpmn:outgoing>Flow_13</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="Task_ConfirmDisbursement" name="Confirmar desembolso">
      <bpmn:incoming>Flow_13</bpmn:incoming>
      <bpmn:outgoing>Flow_14</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:subProcess id="SubProcess_Disbursement" name="Registrar desembolso">
      <bpmn:documentation>Una transacción de base de datos: comprobar el estado APPROVED, cambiar a DISBURSED y crear Disbursement; cualquier fallo revierte la operación. La cuenta y el banco se validan antes de iniciar la transacción.</bpmn:documentation>
      <bpmn:incoming>Flow_14</bpmn:incoming>
      <bpmn:outgoing>Flow_15</bpmn:outgoing>
      <bpmn:startEvent id="Disbursement_Start" name="Inicio">
        <bpmn:outgoing>Disbursement_Flow_1</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:serviceTask id="Disbursement_ValidateApproved" name="Validar APPROVED">
        <bpmn:incoming>Disbursement_Flow_1</bpmn:incoming>
        <bpmn:outgoing>Disbursement_Flow_2</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:serviceTask id="Disbursement_SetDisbursed" name="Marcar DISBURSED">
        <bpmn:incoming>Disbursement_Flow_2</bpmn:incoming>
        <bpmn:outgoing>Disbursement_Flow_3</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:serviceTask id="Disbursement_CreateRecord" name="Crear desembolso">
        <bpmn:incoming>Disbursement_Flow_3</bpmn:incoming>
        <bpmn:outgoing>Disbursement_Flow_4</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:endEvent id="Disbursement_End" name="Fin">
        <bpmn:incoming>Disbursement_Flow_4</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:sequenceFlow id="Disbursement_Flow_1" sourceRef="Disbursement_Start" targetRef="Disbursement_ValidateApproved"/>
      <bpmn:sequenceFlow id="Disbursement_Flow_2" sourceRef="Disbursement_ValidateApproved" targetRef="Disbursement_SetDisbursed"/>
      <bpmn:sequenceFlow id="Disbursement_Flow_3" sourceRef="Disbursement_SetDisbursed" targetRef="Disbursement_CreateRecord"/>
      <bpmn:sequenceFlow id="Disbursement_Flow_4" sourceRef="Disbursement_CreateRecord" targetRef="Disbursement_End"/>
    </bpmn:subProcess>
    <bpmn:endEvent id="End_Disbursed" name="Crédito desembolsado">
      <bpmn:incoming>Flow_15</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_01" sourceRef="Start_AuthenticatedFlow" targetRef="Task_Login"/>
    <bpmn:sequenceFlow id="Flow_02" sourceRef="Task_Login" targetRef="Task_Register"/>
    <bpmn:sequenceFlow id="Flow_03" sourceRef="Task_Register" targetRef="Task_SavePending"/>
    <bpmn:sequenceFlow id="Flow_04" sourceRef="Task_SavePending" targetRef="Task_Review"/>
    <bpmn:sequenceFlow id="Flow_05" sourceRef="Task_Review" targetRef="Gateway_Approved"/>
    <bpmn:sequenceFlow id="Flow_06" name="No" sourceRef="Gateway_Approved" targetRef="Task_Reject"/>
    <bpmn:sequenceFlow id="Flow_07" sourceRef="Task_Reject" targetRef="Task_SetRejected"/>
    <bpmn:sequenceFlow id="Flow_08" sourceRef="Task_SetRejected" targetRef="End_Rejected"/>
    <bpmn:sequenceFlow id="Flow_09" name="Sí" sourceRef="Gateway_Approved" targetRef="Task_Approve"/>
    <bpmn:sequenceFlow id="Flow_10" sourceRef="Task_Approve" targetRef="SubProcess_Approval"/>
    <bpmn:sequenceFlow id="Flow_11" sourceRef="SubProcess_Approval" targetRef="Task_SelectApproved"/>
    <bpmn:sequenceFlow id="Flow_12" sourceRef="Task_SelectApproved" targetRef="Task_EnterBankAccount"/>
    <bpmn:sequenceFlow id="Flow_13" sourceRef="Task_EnterBankAccount" targetRef="Task_ConfirmDisbursement"/>
    <bpmn:sequenceFlow id="Flow_14" sourceRef="Task_ConfirmDisbursement" targetRef="SubProcess_Disbursement"/>
    <bpmn:sequenceFlow id="Flow_15" sourceRef="SubProcess_Disbursement" targetRef="End_Disbursed"/>
    <bpmn:textAnnotation id="Annotation_ScheduleSearch">
      <bpmn:text>El plan se puede consultar después por identificación; no es un paso obligatorio para desembolsar.</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="Association_ScheduleSearch" sourceRef="SubProcess_Approval" targetRef="Annotation_ScheduleSearch"/>
  </bpmn:process>
  <bpmndi:BPMNDiagram id="Diagram_CreditLifecycle">
    <bpmndi:BPMNPlane id="Plane_CreditLifecycle" bpmnElement="Collaboration_CreditFlow">
      <bpmndi:BPMNShape id="Shape_Participant_CreditFlow" bpmnElement="Participant_CreditFlow" isHorizontal="true"><dc:Bounds x="20" y="20" width="2720" height="700"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Lane_Analyst" bpmnElement="Lane_Analyst" isHorizontal="true"><dc:Bounds x="50" y="20" width="2690" height="140"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Lane_Committee" bpmnElement="Lane_Committee" isHorizontal="true"><dc:Bounds x="50" y="160" width="2690" height="170"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Lane_System" bpmnElement="Lane_System" isHorizontal="true"><dc:Bounds x="50" y="330" width="2690" height="220"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Lane_Operator" bpmnElement="Lane_Operator" isHorizontal="true"><dc:Bounds x="50" y="550" width="2690" height="170"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Start_AuthenticatedFlow" bpmnElement="Start_AuthenticatedFlow"><dc:Bounds x="230" y="72" width="36" height="36"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Task_Login" bpmnElement="Task_Login"><dc:Bounds x="300" y="54" width="140" height="72"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Task_Register" bpmnElement="Task_Register"><dc:Bounds x="480" y="54" width="150" height="72"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Task_SavePending" bpmnElement="Task_SavePending"><dc:Bounds x="680" y="377" width="160" height="72"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Task_Review" bpmnElement="Task_Review"><dc:Bounds x="900" y="207" width="150" height="72"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Gateway_Approved" bpmnElement="Gateway_Approved"><dc:Bounds x="1100" y="218" width="50" height="50"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Task_Reject" bpmnElement="Task_Reject"><dc:Bounds x="1215" y="174" width="150" height="72"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Task_Approve" bpmnElement="Task_Approve"><dc:Bounds x="1215" y="252" width="165" height="72"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Task_SetRejected" bpmnElement="Task_SetRejected"><dc:Bounds x="1440" y="345" width="155" height="72"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_End_Rejected" bpmnElement="End_Rejected"><dc:Bounds x="1650" y="363" width="36" height="36"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_SubProcess_Approval" bpmnElement="SubProcess_Approval" isExpanded="false"><dc:Bounds x="1440" y="435" width="220" height="82"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Task_SelectApproved" bpmnElement="Task_SelectApproved"><dc:Bounds x="1720" y="602" width="165" height="72"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Task_EnterBankAccount" bpmnElement="Task_EnterBankAccount"><dc:Bounds x="1930" y="602" width="175" height="72"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Task_ConfirmDisbursement" bpmnElement="Task_ConfirmDisbursement"><dc:Bounds x="2150" y="602" width="155" height="72"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_SubProcess_Disbursement" bpmnElement="SubProcess_Disbursement" isExpanded="false"><dc:Bounds x="2360" y="435" width="205" height="82"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_End_Disbursed" bpmnElement="End_Disbursed"><dc:Bounds x="2620" y="458" width="36" height="36"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Annotation_ScheduleSearch" bpmnElement="Annotation_ScheduleSearch"><dc:Bounds x="1725" y="350" width="335" height="95"/></bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="Edge_Flow_01" bpmnElement="Flow_01"><di:waypoint x="266" y="90"/><di:waypoint x="300" y="90"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_02" bpmnElement="Flow_02"><di:waypoint x="440" y="90"/><di:waypoint x="480" y="90"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_03" bpmnElement="Flow_03"><di:waypoint x="630" y="90"/><di:waypoint x="655" y="90"/><di:waypoint x="655" y="413"/><di:waypoint x="680" y="413"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_04" bpmnElement="Flow_04"><di:waypoint x="840" y="413"/><di:waypoint x="865" y="413"/><di:waypoint x="865" y="243"/><di:waypoint x="900" y="243"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_05" bpmnElement="Flow_05"><di:waypoint x="1050" y="243"/><di:waypoint x="1100" y="243"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_06" bpmnElement="Flow_06"><di:waypoint x="1150" y="243"/><di:waypoint x="1180" y="243"/><di:waypoint x="1180" y="210"/><di:waypoint x="1215" y="210"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_07" bpmnElement="Flow_07"><di:waypoint x="1365" y="210"/><di:waypoint x="1400" y="210"/><di:waypoint x="1400" y="381"/><di:waypoint x="1440" y="381"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_08" bpmnElement="Flow_08"><di:waypoint x="1595" y="381"/><di:waypoint x="1650" y="381"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_09" bpmnElement="Flow_09"><di:waypoint x="1125" y="268"/><di:waypoint x="1125" y="288"/><di:waypoint x="1215" y="288"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_10" bpmnElement="Flow_10"><di:waypoint x="1380" y="288"/><di:waypoint x="1410" y="288"/><di:waypoint x="1410" y="476"/><di:waypoint x="1440" y="476"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_11" bpmnElement="Flow_11"><di:waypoint x="1660" y="476"/><di:waypoint x="1690" y="476"/><di:waypoint x="1690" y="638"/><di:waypoint x="1720" y="638"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_12" bpmnElement="Flow_12"><di:waypoint x="1885" y="638"/><di:waypoint x="1930" y="638"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_13" bpmnElement="Flow_13"><di:waypoint x="2105" y="638"/><di:waypoint x="2150" y="638"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_14" bpmnElement="Flow_14"><di:waypoint x="2305" y="638"/><di:waypoint x="2330" y="638"/><di:waypoint x="2330" y="476"/><di:waypoint x="2360" y="476"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_15" bpmnElement="Flow_15"><di:waypoint x="2565" y="476"/><di:waypoint x="2620" y="476"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Association_ScheduleSearch" bpmnElement="Association_ScheduleSearch"><di:waypoint x="1660" y="476"/><di:waypoint x="1700" y="476"/><di:waypoint x="1700" y="398"/><di:waypoint x="1725" y="398"/></bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
