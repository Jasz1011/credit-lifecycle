# Copie este archivo como apps/api/.env para ejecutar la API localmente fuera de Docker.
DATABASE_URL="file:../data/credit.db"
PORT=3001
WEB_ORIGIN="http://localhost:3000"
JWT_ACCESS_SECRET="change-this-access-secret-with-at-least-32-characters"
JWT_REFRESH_SECRET="change-this-refresh-secret-with-at-least-32-characters"
JWT_ACCESS_TTL="15m"
JWT_REFRESH_TTL_DAYS=7
